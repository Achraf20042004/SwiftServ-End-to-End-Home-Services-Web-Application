<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="servicesPU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- Entités -->
        <class>com.app.model.Admin</class>
        <class>com.app.model.Client</class>
        <class>com.app.model.Prestataire</class>
        <class>com.app.model.CategorieService</class>
        <class>com.app.model.ServiceDomicile</class>
        <class>com.app.model.Reservation</class>
        <class>com.app.model.Intervention</class>
        <class>com.app.model.Avis</class>
        <class>com.app.model.Reclamation</class>
        <class>com.app.model.Notification</class>

        <properties>
            <!-- Connexion MySQL (valeurs par défaut, surchargées par DB_URL / DB_USER / DB_PASSWORD, voir JpaUtil) -->
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3307/services_domicile?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Configuration Hibernate -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            
            <!-- Gestion automatique du schéma -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            
            <!-- Affichage des requêtes SQL (activer seulement pour déboguer) -->
            <property name="hibernate.show_sql" value="false"/>
            
            <!-- Les JSP lisent des relations LAZY après la fermeture de l'EntityManager -->
            <property name="hibernate.enable_lazy_load_no_trans" value="true"/>
        </properties>
    </persistence-unit>
</persistence>